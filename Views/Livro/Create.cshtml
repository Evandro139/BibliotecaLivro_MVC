@model Livro

<body>

    <h1>Cadastrar Livro</h1>

    <form asp-controller="Livro" asp-action="Create" method="post">

        <div>
            <label>Titulo</label>
            <input type="text" asp-for="Titulo" />
        </div>

        <div>
            <label>Autor</label>
            <input type="text" asp-for="Autor" />
        </div>

        <div>
            <label>Genero</label>
            <input type="text" asp-for="Genero" />
        </div>

        <div>
            <label>Ano</label>
            <input type="number" asp-for="AnoPublicacao" />
        </div>

        <div>
            <label>Páginas</label>
            <input type="number" asp-for="QuantidadePaginas" />
        </div>

        <div>
            <label>Sinopse</label>
            <textarea asp-for="Sinopse"></textarea>
        </div>

        <button type="submit">
            Salvar
        </button>

    </form>

</body>